NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used by /api/games/[id]/hands to save scored hands atomically.
# Supabase: Project Settings -> API -> service_role. In Vercel add it as a normal (non-public) environment variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
